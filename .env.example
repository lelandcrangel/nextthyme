# Where the recipe box is read from. Copy to .env.local to use.
#
# Unset (the default): this browser's localStorage, as before. A fresh clone,
# `npm run dev` and the smoke tests need no database.
#
# Set: the PHP endpoint, read-only for visitors.
#   development   /api/recipes.php            (or just `npm run dev:api`)
#   production    /nextthyme/api/recipes.php  (only once the Hostinger
#                 database exists, or every visitor sees the fallback notice)
VITE_RECIPES_API=
