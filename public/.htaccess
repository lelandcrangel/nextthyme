Options -MultiViews

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /nextthyme/

  RewriteRule ^index\.html$ - [L]
  RewriteRule ^(?:assets|images)/ - [L]

  # The API answers for itself: a mistyped endpoint is a 404, not the SPA's
  # index.html with a 200. bootstrap.php is shared code, not an endpoint.
  RewriteRule ^api/bootstrap\.php$ - [R=404,L]
  RewriteRule ^api/ - [L]

  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  RewriteRule . /nextthyme/index.html [L]
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(?:css|js|webp|ico|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "^(?:index\.html|\.htaccess)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
